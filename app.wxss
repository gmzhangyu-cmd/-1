page {
  min-height: 100%;
  background: #f4f7f5;
  color: #20332a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page {
  box-sizing: border-box;
  padding: 28rpx 28rpx 56rpx;
}

.hero {
  padding: 20rpx 4rpx 28rpx;
}

.hero-title {
  display: block;
  font-size: 48rpx;
  line-height: 1.25;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #6d7d75;
  font-size: 26rpx;
}

.card {
  box-sizing: border-box;
  margin-bottom: 22rpx;
  padding: 28rpx;
  border: 1rpx solid #e6ece8;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 38rpx rgba(32, 65, 47, 0.055);
}

.card-title {
  display: block;
  margin-bottom: 22rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.muted { color: #7d8b84; }
.small { font-size: 24rpx; }
.danger { color: #b53b45; }
.success { color: #287a55; }
.warning { color: #a56a16; }

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #56665e;
  font-size: 25rpx;
  font-weight: 550;
}

.input,
.picker,
.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #dce5df;
  border-radius: 18rpx;
  background: #fafcfb;
  color: #20332a;
}

.textarea {
  min-height: 150rpx;
}

.two-column {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.primary-button,
.secondary-button,
.danger-button {
  margin: 18rpx 0 0;
  border: 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.primary-button {
  background: #287a55;
  color: #ffffff;
}

.secondary-button {
  background: #eaf3ee;
  color: #286347;
}

.danger-button {
  background: #fff0f1;
  color: #ad3440;
}

.primary-button::after,
.secondary-button::after,
.danger-button::after { border: 0; }

.tag {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #edf5f0;
  color: #287a55;
  font-size: 23rpx;
}

.empty {
  padding: 42rpx 20rpx;
  color: #829087;
  text-align: center;
}
