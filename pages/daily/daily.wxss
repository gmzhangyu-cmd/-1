.date-chip { padding: 13rpx 18rpx; border-radius: 15rpx; background: #fde7ef; color: #ca557d; font-size: 23rpx; }
.no-margin { margin: 0; }
.card-head { margin-bottom: 22rpx; }
.pink-link { color: #d45c84; font-size: 23rpx; }
.bmi-box { display: flex; align-items: center; gap: 20rpx; margin: 0 0 24rpx; padding: 20rpx 24rpx; border-radius: 17rpx; background: #fceaf1; color: #936c7a; font-size: 24rpx; }
.bmi-value { color: #c95079; font-size: 32rpx; font-weight: 700; }
.bmi-note { margin-left: auto; color: #b1929d; font-size: 20rpx; }
.meal-row { display: flex; gap: 18rpx; padding: 22rpx 0; border-bottom: 1rpx solid #f3e4e9; }
.meal-row.last { border-bottom: 0; }
.meal-icon { padding-top: 5rpx; font-size: 38rpx; }
.meal-content { flex: 1; }
.meal-input { box-sizing: border-box; width: 100%; height: 105rpx; padding: 17rpx 19rpx; border-radius: 15rpx; background: #fff8fa; color: #59434b; font-size: 25rpx; }
.water-total { color: #d15b82; font-size: 22rpx; }
.bottle-grid { display: grid; grid-template-columns: repeat(4, 1fr); align-items: end; gap: 10rpx; }
.bottle-option { display: flex; flex-direction: column; align-items: center; }
.bottle-wrap { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 155rpx; }
.bottle-cap { width: 30rpx; height: 12rpx; border-radius: 5rpx 5rpx 2rpx 2rpx; background: #efa0b9; }
.bottle { position: relative; overflow: hidden; width: 64rpx; border: 3rpx solid #efb7c9; border-radius: 15rpx 15rpx 20rpx 20rpx; background: rgba(255,255,255,.7); }
.bottle-xs { height: 50rpx; }.bottle-sm { height: 76rpx; }.bottle-md { height: 103rpx; }.bottle-lg { height: 135rpx; }
.water-fill { position: absolute; right: 5rpx; bottom: 5rpx; left: 5rpx; height: 48%; border-radius: 7rpx 7rpx 13rpx 13rpx; background: linear-gradient(#f9d2df,#f2a8c0); }
.bottle-label { margin: 11rpx 0; color: #9e818c; font-size: 19rpx; }
.counter { display: flex; align-items: center; justify-content: space-between; width: 125rpx; padding: 7rpx 8rpx; border-radius: 999rpx; background: #fdebf2; color: #d25880; font-size: 26rpx; }
.counter text { min-width: 30rpx; text-align: center; }.counter .count { color: #5b414b; font-size: 23rpx; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.feedback-pop { position: fixed; z-index: 20; top: 45%; left: 50%; width: 530rpx; box-sizing: border-box; padding: 30rpx 34rpx; border-radius: 24rpx; background: rgba(91,55,69,.94); color: #fff; font-size: 28rpx; font-weight: 600; line-height: 1.5; text-align: center; box-shadow: 0 20rpx 55rpx rgba(92,49,66,.24); transform: translate(-50%,-50%); animation: popFade 1.6s ease both; }
@keyframes popFade { 0% { opacity: 0; transform: translate(-50%,-40%) scale(.92); } 15%,75% { opacity: 1; transform: translate(-50%,-50%) scale(1); } 100% { opacity: 0; transform: translate(-50%,-55%) scale(.96); } }
