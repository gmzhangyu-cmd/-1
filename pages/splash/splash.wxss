page { background: #fbe9ed; overflow: hidden; }
.splash { position: relative; width: 100vw; height: 100vh; overflow: hidden; transform: scale(1); opacity: 1; transition: transform .75s ease, opacity .75s ease; }
.splash.leaving { transform: scale(.72); opacity: 0; }
.welcome-image { position: absolute; inset: 0; width: 100%; height: 100%; animation: breathe 2.8s ease both; }
.soft-mask { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(255,247,242,.72) 0%, rgba(255,245,247,.08) 35%, rgba(86,44,57,.12) 100%); }
.quote-wrap { position: absolute; z-index: 2; top: 15vh; left: 56rpx; right: 56rpx; text-align: center; animation: rise .8s ease both; }
.tiny-mark { display: block; margin-bottom: 22rpx; color: #d17191; font-size: 21rpx; letter-spacing: 8rpx; }
.quote { display: block; color: #704957; font-size: 48rpx; font-weight: 700; line-height: 1.45; text-shadow: 0 3rpx 18rpx rgba(255,255,255,.8); }
.skip { display: inline-block; margin-top: 34rpx; padding: 12rpx 25rpx; border-radius: 999rpx; background: rgba(255,255,255,.68); color: #a87586; font-size: 22rpx; }
@keyframes breathe { from { transform: scale(1.06); } to { transform: scale(1); } }
@keyframes rise { from { opacity: 0; transform: translateY(30rpx); } to { opacity: 1; transform: translateY(0); } }
