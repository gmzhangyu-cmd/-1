.register-page { min-height: 100vh; box-sizing: border-box; padding: 100rpx 46rpx 60rpx; background: linear-gradient(180deg,#fff3f7,#fffafb); text-align: center; }
.phone-art { display: flex; align-items: center; justify-content: center; width: 120rpx; height: 120rpx; margin: 0 auto 30rpx; border-radius: 38rpx; background: linear-gradient(135deg,#f5a3bd,#dd668e); color: #fff; font-size: 68rpx; box-shadow: 0 18rpx 38rpx rgba(205,84,125,.18); }.register-title,.register-subtitle { display: block; }.register-title { color: #593e48; font-size: 40rpx; font-weight: 700; }.register-subtitle { max-width: 590rpx; margin: 18rpx auto 48rpx; color: #9d828c; font-size: 24rpx; line-height: 1.6; }
.phone-field { display: flex; align-items: center; padding: 0 25rpx; border: 1rpx solid #efd4de; border-radius: 20rpx; background: #fff; text-align: left; }.prefix { padding-right: 22rpx; border-right: 1rpx solid #efdfe5; color: #765b65; }.phone-input { flex: 1; height: 96rpx; padding-left: 22rpx; }
.agreement { display: flex; align-items: flex-start; gap: 10rpx; margin: 27rpx 4rpx; color: #967d86; font-size: 21rpx; line-height: 1.55; text-align: left; }.agreement checkbox { transform: scale(.78); }.register-button { margin-top: 30rpx; }.backend-note { display: block; margin-top: 28rpx; color: #b39ca4; font-size: 20rpx; line-height: 1.55; }
