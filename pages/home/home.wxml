<view class="page">
  <view class="topbar row">
    <text class="date">{{today}}</text>
    <view class="register-chip" bindtap="goRegister">{{profileLabel}}</view>
  </view>

  <view class="quote-hero">
    <text class="quote-kicker">TODAY</text>
    <text class="quote-text">{{quote}}</text>
  </view>

  <view class="shot-card">
    <view class="syringe" aria-label="针管图案">💉</view>
    <view class="shot-content">
      <text class="shot-label">下一次计划</text>
      <text class="shot-date">{{nextShot.date || '待记录'}}</text>
      <text class="shot-note {{nextShot.tone}}">{{nextShot.text}}</text>
    </view>
    <view class="shot-add" bindtap="goNeedle">＋</view>
  </view>

  <view class="expiry-line row">
    <text>有效期</text>
    <text class="{{expiry.tone}}">{{expiry.text}}</text>
  </view>

  <view class="section-heading row">
    <text>身体数据</text>
    <text class="section-link" bindtap="goTrends">查看变化曲线 →</text>
  </view>
  <view class="body-grid" bindtap="goTrends">
    <view class="body-item" wx:for="{{bodyItems}}" wx:key="label">
      <text class="body-label">{{item.label}}</text>
      <text class="body-value">{{item.value}}</text>
    </view>
  </view>
  <view class="target-pill">🎯 {{targetText}}</view>

  <view class="section-heading row">
    <text>今日生活</text>
    <text class="section-link" bindtap="goDaily">去记录 →</text>
  </view>
  <view class="life-card" bindtap="goDaily">
    <view class="life-item">
      <text class="life-icon">🍽️</text>
      <view><text class="life-value">{{mealCount}} / 3 餐</text><text class="life-label">三餐记录</text></view>
    </view>
    <view class="life-divider"></view>
    <view class="life-item">
      <text class="life-icon">🫧</text>
      <view><text class="life-value">{{water.count}} 瓶</text><text class="life-label">约 {{water.liters}} L</text></view>
    </view>
  </view>

  <view class="notice">只做生活记录，不替代医生的诊断和用药建议。</view>
</view>
